# Overrides for this app's scripts (copy to .now.env; git-ignored). All optional
# when .zilch.config is present. Precedence: environment > .now.env > .zilch.config.
#PROJECT=my-gcp-project
#REGION=us-central1
# Cloud Run service to deploy to. Defaults to zilch's app_name.
#SERVICE=now
# The one Google account that may sign in (deploy.sh / init.sh set it on the service).
#ALLOWED_EMAIL=you@example.com
# Firebase Hosting site (<site>.web.app). Defaults to zilch's app_name.
#HOSTING_SITE=now-app
