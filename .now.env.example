# Overrides for this app's scripts (copy to .now.env; git-ignored). All optional
# when .zilch.config is present. Precedence: environment > .now.env > .zilch.config.
#PROJECT=my-gcp-project
#REGION=us-central1
# Cloud Run service to deploy to. Defaults to zilch's app_name.
#SERVICE=now
# Google accounts that may sign in, first is the owner (deploy.sh / init.sh set it on
# the service). Separate several with ; (gcloud splits env values on commas).
#ALLOWED_EMAILS=you@example.com;kid@example.com
# Timezone for the reminder job's daytime window (default: this machine's).
#SCHEDULE_TZ=America/Los_Angeles
# Firebase Hosting site (<site>.web.app). Defaults to zilch's app_name.
#HOSTING_SITE=now-app
